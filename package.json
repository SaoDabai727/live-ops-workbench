{
  "name": "live-ops-workbench",
  "version": "1.5.14",
  "description": "直播运营助手 - 多直播间监控与日报生成一体工作台",
  "main": "main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:dir": "electron-builder --win --dir --publish never",
    "test": "node test/unit-test.js",
    "test-regex": "node test/regex-test.js test/sample-compass.txt",
    "test-regex:douyin": "node test/regex-test.js test/sample-douyin.txt"
  },
  "build": {
    "appId": "com.liveops.workbench",
    "productName": "直播运营助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "config/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "live-ops-workbench-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "直播运营助手",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": null,
      "differentialPackage": true,
      "artifactName": "live-ops-workbench-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "live-ops-workbench-Portable-${version}.${ext}"
    },
    "extraMetadata": {
      "main": "main/index.js"
    },
    "asar": true,
    "asarUnpack": [
      "config/*.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SaoDabai727",
        "repo": "live-ops-workbench"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  }
}
